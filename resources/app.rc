#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "app.manifest"

// IDI_APP_ICON ICON "app.ico"   // Add an .ico file in resources/ and uncomment to embed

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EnViDict"
            VALUE "FileDescription", "Lightweight English-Vietnamese popup dictionary"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "EnViDict"
            VALUE "OriginalFilename", "EnViDict.exe"
            VALUE "ProductName", "EnViDict"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
